SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-01

# Cross-call metadata cache TTL (seconds) — A8 / Story 10.32.
# How long the publication-channels roster is cached across MCP tool calls before
# a re-fetch (default 600 = 10m). Channel-affecting writes (publish/unpublish)
# invalidate the entry immediately, independent of this TTL.
CACHE_TTL_CHANNELS_S=600

# Webhook receiver (Railway deployment — filled in after PR Workstream 2)
WEBHOOK_RECEIVER_URL=https://your-app.railway.app/webhooks

# REQUIRED for register_webhook (M3 / SEC-17 — Story 10.51).
# Comma-separated hostnames allowed as webhook endpoints. register_webhook
# fails closed: with this unset, every registration is refused outright
# (no mutation happens, regardless of confirm=True). Endpoints must also be
# https — no other scheme is accepted.
WEBHOOK_ALLOWLIST_HOSTS=your-app.railway.app

# Escape hatch only — do NOT set this in normal operation. Restores the old
# warn-and-proceed behavior (any https host is allowed, with a ⚠ EXTERNAL
# DOMAIN warning in the preview) instead of the WEBHOOK_ALLOWLIST_HOSTS
# fail-closed default above.
# WEBHOOK_ALLOW_ANY_HOST=true

# ===================================================================
# NOT USED BY THIS SERVER — receiver-only secrets for reference only
# ===================================================================
# These secrets are used only by the remote receiver (e.g., Railway webhook handler)
# and are NOT read or used by this MCP server. They are listed here for operational
# reference only if you maintain the receiver in the same deployment.

# Shopify webhook HMAC signing secret (Custom App → API credentials → Client secret)
# NOT used by this server
# SHOPIFY_WEBHOOK_SECRET=your_client_secret_here

# GA4 Measurement Protocol (used by remote receiver; stored here for reference)
# NOT used by this server
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_ga4_api_secret_here
