# Credentials — never commit
.env

# Write operation log — local only
aon_mcp_log.txt

# Collaboration and AI session artifacts
COLLABORATION_REPORT.md
COLLABORATION_REPORT_GRAPHQL.md
CLAUDE.md
mcp-server-security-review.md
OPEN_STORIES.md

# Personal context files — local-only notes and reference material
context/

# Personal accomplishment-export artifacts (weekly date-suffixed files)
ACCOMPLISHMENTS_*.md
accomplishments_*.html
accomplishments_*.svg
accomplishments_*.png

# Personal dump folder — non-MCP files that shouldn't be checked in.
# Anything dropped here is automatically excluded from git.
_personal/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environment
# Glob, not a literal: per-worktree venvs get suffixed names (.venv-wt, .venv-ci,
# .venv-audit) because a worktree can't share the main checkout's editable install.
# Those fell outside a bare `.venv/` and showed up as thousands of untracked files
# — which PR widgets that count working-tree additions fold into the diff (a 178 MB
# .venv-ci and a +61,949-line PR chip, both traced to this in Aug 2026).
.venv*/
venv*/
ENV/

# macOS
.DS_Store

# IDEs
.vscode/
.idea/
*.swp
